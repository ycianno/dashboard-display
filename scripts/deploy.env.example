# Where the wall panel lives. Copy to scripts/deploy.env and edit.
# deploy.env is git-ignored: this repo is public, and a host alias plus a
# Windows user directory are not worth publishing.

# An ssh target — a ~/.ssh/config alias, or user@host.
DASHBOARD_HOST=dashboard-panel

# The install directory on the panel, as scp sees it. Forward slashes.
DASHBOARD_REMOTE_DIR=C:/Users/YOU/dashboard-display
